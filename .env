# Disabled: ngrok closes the session outright when asked for a subdomain that
# is not reserved on this account ("failed to start tunnel / session closed").
# Expo derives a stable-enough host from the account anyway, e.g.
# https://<id>-asheeshsahu7300-8081.exp.direct. Re-enable only if this
# subdomain is actually reserved on the ngrok plan in ~/.expo/ngrok.yml.
# EXPO_TUNNEL_SUBDOMAIN=
EXPO_PACKAGER_HOSTNAME=https://iptv-portal-28.preview.emergentagent.com
EXPO_PUBLIC_BACKEND_URL=https://iptv-portal-28.preview.emergentagent.com
METRO_CACHE_ROOT=/app/frontend/.metro-cache
EXPO_TUNNEL_SUBDOMAIN=iptv-portal-28