{
  "expo": {
    "name": "Infinity IPTV Player",
    "slug": "infinity-iptv-player",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "infinityiptv",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinity.iptvplayer"
    },
    "android": {
      "package": "com.infinity.iptvplayer",
      "edgeToEdgeEnabled": true,
      "largeHeap": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "leanbackIcon": "./assets/images/splash-icon.png",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "androidTV": {
      "icon": "./assets/images/tv-icon.png",
      "banner": "./assets/images/splash-icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 600,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "./plugins/withTabletLandscape",
      "./plugins/withHandsetPortrait",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/images/splash-icon.png",
          "androidTVRequired": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bf901df-8bd7-41a3-b109-d291ac6443f8"
      }
    },
    "owner": "asheeshsahu7300"
  }
}
