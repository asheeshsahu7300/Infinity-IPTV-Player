{
  "expo": {
    "name": "Infinity IPTV Player",
    "slug": "infinity-iptv-player",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "infinityiptv",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinity.iptvplayer",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allows Infinity IPTV Player to discover and stream media from network sources."
      }
    },
    "android": {
      "package": "com.infinity.iptvplayer",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withTransparentSplashIcon",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ]
          }
        }
      ],
      "./plugins/withTabletLandscape",
      "./plugins/withHandsetPortrait",
      "./plugins/withImmersiveMainActivity",
      "./plugins/withAndroidManifestExtras",
      "./plugins/withFfmpegDecoder",
      "./plugins/withGradleBuildTweaks",
      "./plugins/withAutolinkingCacheGuard",
      "./plugins/withDarkWindowBackground",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/images/splash-icon.png",
          "androidTVRequired": false
        }
      ],
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bf901df-8bd7-41a3-b109-d291ac6443f8"
      }
    },
    "owner": "asheeshsahu7300"
  }
}
