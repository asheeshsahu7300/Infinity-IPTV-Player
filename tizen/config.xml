<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:tizen="http://tizen.org/ns/widgets" 
        id="http://infinity.com/iptvplayer" 
        version="1.0.0" 
        viewmodes="maximized">
    <tizen:application id="xInfinity1.InfinityIPTV" 
                       package="xInfinity1" 
                       required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>Infinity IPTV Player</name>
    <description>High-performance modern IPTV player for live TV, movies, and series streaming on Samsung Smart TV.</description>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/drm.playready"/>
    <tizen:content-security-policy>default-src * 'self' 'unsafe-inline' 'unsafe-eval' data: blob: file:; script-src * 'self' 'unsafe-inline' 'unsafe-eval' file: blob:; style-src * 'self' 'unsafe-inline' file: blob:; img-src * 'self' data: blob: file: http: https:; media-src * 'self' data: blob: file: http: https:; connect-src * 'self' data: blob: file: http: https: ws: wss:; font-src * 'self' data: blob: file: http: https:;</tizen:content-security-policy>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
</widget>

